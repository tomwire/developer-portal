# =============================================================================
# Scaffold Output — Kubernetes Deployment Template
# =============================================================================
# Kustomize base deployment for every scaffolded service.
# Environment overlays provide replica counts, resource limits, and image refs.
# =============================================================================

apiVersion: apps/v1
kind: Deployment
metadata:
  name: <%= serviceName %>
  namespace: idp-dev
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: <%= serviceName %>
  template:
    metadata:
      labels:
        app.kubernetes.io/name: <%= serviceName %>
        app.kubernetes.io/component: backend
    spec:
      containers:
        - name: <%= serviceName %>
          image: docker.io/library/<%= serviceName %>:latest
          ports:
            - containerPort: <%= port %>
              name: http
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
          livenessProbe:
            httpGet:
              path: /healthz
              port: <%= port %>
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /readyz
              port: <%= port %>
            initialDelaySeconds: 10
            periodSeconds: 5

---
apiVersion: v1
kind: Service
metadata:
  name: <%= serviceName %>
  namespace: idp-dev
spec:
  type: ClusterIP
  ports:
    - port: 80
      targetPort: <%= port %>
      protocol: TCP
  selector:
    app.kubernetes.io/name: <%= serviceName %>
